{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/session-start-refresh.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/scratch-sweep.mjs"
            ],
            "timeout": 15
          }
        ],
        "matcher": "startup"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/prompt-refresh-timer.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/prompt-resume-word.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/clock-now.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/knowledge-moment.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/context-window.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/clock-now.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/subagent-preamble.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/no-backslash-heredoc.mjs"
            ],
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/stamp-gate.mjs"
            ],
            "timeout": 5
          }
        ],
        "matcher": "Write|Edit|MultiEdit|Bash|PowerShell"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/knowledge-moment.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/context-window.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/test-after-code.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/knowledge-moment.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/stop-status-guard.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/stop-farewell-capture.mjs"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.kaif/hooks/test-after-code.mjs"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/hooks/no-permission-question.mjs"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
